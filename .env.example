# BoostX Environment Configuration

# Flask Core Configuration
FLASK_ENV=development
SECRET_KEY=change-this-to-a-secure-random-32-character-secret-key
# For local sqlite testing, use sqlite:///boostx.db
# For production, DATABASE_URL must be a postgresql:// URL (e.g. postgresql://boostx:boostx_pass@localhost:5432/boostx_db)
DATABASE_URL=postgresql://boostx:boostx_pass@localhost:5432/boostx_db
UPLOAD_FOLDER=backend/uploads

# Session & Security
# Sessions are signed HttpOnly cookies. Secure cookies default to on when FLASK_ENV=production.
SESSION_COOKIE_SECURE=false
# How long a login lasts, in hours (default 168 = 7 days)
SESSION_LIFETIME_HOURS=168
# Browser cross-origin access is off by default (the SPA is served by this app).
# CORS_ORIGINS=https://app.example.com

# Fulfillment Provider Configuration
# Set PROVIDER_MODE=fake for offline development/testing, or live for production.
PROVIDER_MODE=fake
PROVIDER_API_URL=https://boostcenter2.com/api/v2
PROVIDER_API_KEY=your_provider_api_key_here

# Gemini AI Vision Verification Configuration (Supports AI_API_KEY or OPENAI_API_KEY)
AI_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-2.0-flash-lite
OPENAI_VISION_MODEL=gemini-2.0-flash-lite

# Pricing Defaults
DEFAULT_USD_TO_GHS=10.70
USD_TO_GHS_RATE=10.70
DEFAULT_FLAT_MARKUP_GHS=5.00
FLAT_MARKUP_GHS=5.00

# Redis & RQ Queue (Background Workers)
REDIS_URL=redis://localhost:6379/0

# Administrator login. The admin signs in on the normal login page with these
# values; they are only ever read on the server and never sent to the browser.
# Set them in your private, gitignored .env or as Render secret variables.
# If either is unset, admin login is disabled. Use a long, unique password.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-unique-password
